# Copy to .env and adjust. All vars are optional; defaults work out of the box.

# Storage (SQLite by default; use PostgreSQL for production)
DATAHUB_DATABASE_URL=sqlite:///./datahub.db
# Production example (requires the [postgres] extra -> psycopg 3):
# DATAHUB_DATABASE_URL=postgresql+psycopg://datahub:datahub@localhost:5432/datahub

# Path to the Excel registry
DATAHUB_CATALOG_PATH=data/Michelle_Datasource_2026-06-02.xlsx

# Fetching
DATAHUB_REQUEST_TIMEOUT=20
DATAHUB_RSSHUB_BASE_URL=https://rsshub.app
DATAHUB_MAX_ITEMS_PER_FETCH=100

# Scheduling
DATAHUB_REALTIME_INTERVAL_SECONDS=120
DATAHUB_MIN_INTERVAL_SECONDS=60
# Global refresh of ALL enabled sources every N hours (0 disables it)
DATAHUB_REFRESH_ALL_HOURS=2
# Where each refresh writes its stats report (empty disables)
DATAHUB_REPORT_DIR=reports

# REST API
DATAHUB_API_HOST=0.0.0.0
DATAHUB_API_PORT=8000
# Set to 0 to run the scheduler as a separate worker instead of inside the API
DATAHUB_API_SCHEDULER=1

# Optional provider credentials (only for paid/API sources)
# DATAHUB_FMP_API_KEY=
# DATAHUB_FRED_API_KEY=
# DATAHUB_TWITTERAPI_IO_KEY=
# DATAHUB_ACLED_API_KEY=
